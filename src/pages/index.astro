---
// Home page: the "generate Eric" box. Pre-filled with one prompt; whatever
// is in the box is sent as the scene.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="fixmy.codes" description="Eric Shen, software engineer.">
  <section class="gen">
    <form id="gen-form">
      <textarea id="gen-scene" rows="4" required></textarea>
      <button type="submit">Go</button>
    </form>
    <p id="gen-note" class="muted">Prompts and images are visible to me, but not who sent them.</p>
    <figure id="gen-out" hidden>
      <img id="gen-img" alt="Eric" />
      <figcaption id="gen-cap"></figcaption>
    </figure>
    <p id="gen-status" class="muted" hidden></p>
    <div id="gen-tray" hidden></div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('gen-form') as HTMLFormElement;
  const scene = document.getElementById('gen-scene') as HTMLTextAreaElement;
  const out = document.getElementById('gen-out') as HTMLElement;
  const img = document.getElementById('gen-img') as HTMLImageElement;
  const cap = document.getElementById('gen-cap') as HTMLElement;
  const status = document.getElementById('gen-status') as HTMLElement;
  const tray = document.getElementById('gen-tray') as HTMLElement;

  // Tray of this browser's past generations (localStorage, newest first, no server).
  type Item = { url: string; scene: string };
  const KEY = 'gen-tray';
  const load = (): Item[] => { try { return JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch { return []; } };
  const alt = (item: Item) => (item.scene ? `Eric ${item.scene}` : 'Eric');
  const show = (item: Item) => {
    img.src = item.url;
    img.alt = alt(item);
    cap.textContent = item.scene;
    out.hidden = false;
  };
  const renderTray = (items: Item[]) => {
    tray.replaceChildren(...items.map((item) => {
      const b = document.createElement('button');
      b.type = 'button';
      const t = document.createElement('img');
      t.src = item.url;
      t.alt = alt(item);
      t.loading = 'lazy';
      b.append(t);
      b.addEventListener('click', () => show(item));
      return b;
    }));
    tray.hidden = items.length === 0;
  };
  renderTray(load());

  // The bar starts with the prompt that renders best; edit it and Go. The LoRA
  // trigger word and the "Medium shot." suffix are added inside the fal workflow.
  scene.value = 'a lanky chinese-american guy with a handlebar mustache, is cooking in a home kitchen, stirring a pan on the stove. He wears a dark apron over a t-shirt. He is frying up some ginger scallion crab. A stockpot is on the burner, and on the counter are clams in a bowl.';

  const generate = async (text: string) => {
    status.hidden = false;
    status.textContent = 'Generating…';
    try {
      const r = await fetch('/api/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ scene: text }),
      });
      if (!r.ok) throw new Error(await r.text());
      const { url } = await r.json();
      const item: Item = { url, scene: text };
      show(item);
      status.hidden = true;
      const items = [item, ...load()].slice(0, 24);
      try { localStorage.setItem(KEY, JSON.stringify(items)); } catch {}
      renderTray(items);
    } catch (err) {
      status.textContent = `Could not generate: ${(err as Error).message}`;
    }
  };
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    generate(scene.value.trim());
  });
  scene.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
  });
</script>

<style>
  #gen-form { display: flex; gap: 0.5rem; align-items: flex-start; margin-bottom: 0.5rem; }
  #gen-note { margin: 0 0 1.5rem; font-size: 0.9rem; }
  #gen-scene { flex: 1; min-width: 0; resize: vertical; font: inherit; }
  #gen-cap { margin-top: 0.5rem; color: #666; font-size: 0.9rem; }
  #gen-out { margin: 0; }
  #gen-img { max-width: 100%; height: auto; display: block; }
  #gen-tray { display: flex; gap: 0.5rem; overflow-x: auto; margin-top: 1.5rem; }
  #gen-tray :global(button) { flex: 0 0 auto; padding: 0; border: 0; background: none; cursor: pointer; }
  #gen-tray :global(img) { width: 72px; height: 96px; object-fit: cover; display: block; }
</style>
