---
// Home page: the "What has Eric been up to?" generator.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="fixmy.codes" description="Eric Shen, software engineer.">
  <section class="gen">
    <h1>What has Eric been up to?</h1>
    <form id="gen-form">
      <input id="gen-scene" type="text" placeholder="cooking at a night market" autocomplete="off" required />
      <button type="submit">Generate</button>
    </form>
    <figure id="gen-out" hidden>
      <img id="gen-img" alt="" />
      <figcaption id="gen-prompt" class="muted"></figcaption>
    </figure>
    <p id="gen-status" class="muted" hidden></p>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('gen-form') as HTMLFormElement;
  const scene = document.getElementById('gen-scene') as HTMLInputElement;
  const out = document.getElementById('gen-out') as HTMLElement;
  const img = document.getElementById('gen-img') as HTMLImageElement;
  const status = document.getElementById('gen-status') as HTMLElement;
  const promptOut = document.getElementById('gen-prompt') as HTMLElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.hidden = false;
    status.textContent = 'Generating…';
    try {
      const r = await fetch('/api/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ scene: scene.value }),
      });
      if (!r.ok) throw new Error(await r.text());
      const { url, prompt } = await r.json();
      img.src = url;
      promptOut.textContent = prompt ?? '';
      img.alt = `Eric ${scene.value}`;
      out.hidden = false;
      status.hidden = true;
    } catch (err) {
      status.textContent = `Could not generate: ${(err as Error).message}`;
    }
  });
</script>

<style>
  .gen h1 { margin-bottom: 1rem; }
  #gen-form { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
  #gen-scene { flex: 1; min-width: 0; }
  #gen-out { margin: 0; }
  #gen-img { max-width: 100%; height: auto; display: block; }
  #gen-prompt { font-size: 0.8rem; line-height: 1.4; margin-top: 0.5rem; }
</style>
