---
// Home page: the "generate Eric" box. Pre-filled with one of a few default
// prompts, rotating per visit; whatever is in the box is sent as the scene.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="fixmy.codes" description="Eric Shen, software engineer.">
  <section class="gen">
    <form id="gen-form">
      <input id="gen-scene" type="text" autocomplete="off" required />
      <button type="submit">Go</button>
    </form>
    <figure id="gen-out" hidden>
      <img id="gen-img" alt="Eric" />
    </figure>
    <p id="gen-status" class="muted" hidden></p>
    <div id="gen-tray" hidden></div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('gen-form') as HTMLFormElement;
  const scene = document.getElementById('gen-scene') as HTMLInputElement;
  const out = document.getElementById('gen-out') as HTMLElement;
  const img = document.getElementById('gen-img') as HTMLImageElement;
  const status = document.getElementById('gen-status') as HTMLElement;
  const tray = document.getElementById('gen-tray') as HTMLElement;

  // Tray of this browser's past generations (localStorage, newest first, no server).
  type Item = { url: string; scene: string };
  const KEY = 'gen-tray';
  const load = (): Item[] => { try { return JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch { return []; } };
  const alt = (item: Item) => (item.scene ? `Eric ${item.scene}` : 'Eric');
  const show = (item: Item) => {
    img.src = item.url;
    img.alt = alt(item);
    out.hidden = false;
  };
  const renderTray = (items: Item[]) => {
    tray.replaceChildren(...items.map((item) => {
      const b = document.createElement('button');
      b.type = 'button';
      const t = document.createElement('img');
      t.src = item.url;
      t.alt = alt(item);
      t.loading = 'lazy';
      b.append(t);
      b.addEventListener('click', () => show(item));
      return b;
    }));
    tray.hidden = items.length === 0;
  };
  renderTray(load());

  // Default prompts, one per visit in order. The LoRA trigger word and the
  // "Medium shot." suffix are added inside the fal workflow, not here.
  const DEFAULTS = [
    'a lanky chinese-american guy with a handlebar mustache, is cooking in a home kitchen, stirring a pan on the stove. He wears a dark apron over a t-shirt. He is frying up some ginger scallion crab. A stockpot is on the burner, and on the counter are clams in a bowl.',
    'a lanky chinese-american guy with a handlebar mustache, is standing on a small aluminum boat on gray water, holding up a wire crab pot with a large Dungeness crab inside. He wears orange rain bib overalls and a beanie. Forested shoreline behind him. Overcast light.',
    'a lanky chinese-american guy with a handlebar mustache, is frying a fish fillet in a cast iron pan in a home kitchen, holding a pot lid up in front of his chest like a shield. Oil is spattering from the pan. He wears a dark apron over a t-shirt. Warm light.',
    'a lanky chinese-american guy with a handlebar mustache, is on a turf soccer field at dusk with his hands on his knees and a soccer ball at his feet. He wears a plain gray jersey and shorts. A chain-link fence with a few people slumped against it is out of focus behind him. Orange sky.',
    'a lanky chinese-american guy with a handlebar mustache, is hunched over a laptop in a dark office, terrible posture, looking unhappily at the screen, dressed in a gray carhartt shirt.',
    'a lanky chinese-american guy with a handlebar mustache, is eating a whole Dungeness crab at his desk with a laptop open beside it, newspaper spread under the crab. A small single-person office with a window looking over a parking lot. Flat gray daylight.',
  ];
  const DKEY = 'gen-default';
  let n = 0;
  try { n = Number(localStorage.getItem(DKEY)) || 0; } catch {}
  scene.value = DEFAULTS[n % DEFAULTS.length];
  try { localStorage.setItem(DKEY, String(n + 1)); } catch {}

  const generate = async (text: string) => {
    status.hidden = false;
    status.textContent = 'Generating…';
    try {
      const r = await fetch('/api/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ scene: text }),
      });
      if (!r.ok) throw new Error(await r.text());
      const { url } = await r.json();
      const item: Item = { url, scene: text };
      show(item);
      status.hidden = true;
      const items = [item, ...load()].slice(0, 24);
      try { localStorage.setItem(KEY, JSON.stringify(items)); } catch {}
      renderTray(items);
    } catch (err) {
      status.textContent = `Could not generate: ${(err as Error).message}`;
    }
  };
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    generate(scene.value.trim());
  });
</script>

<style>
  #gen-form { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
  #gen-scene { flex: 1; min-width: 0; }
  #gen-out { margin: 0; }
  #gen-img { max-width: 100%; height: auto; display: block; }
  #gen-tray { display: flex; gap: 0.5rem; overflow-x: auto; margin-top: 1.5rem; }
  #gen-tray :global(button) { flex: 0 0 auto; padding: 0; border: 0; background: none; cursor: pointer; }
  #gen-tray :global(img) { width: 72px; height: 96px; object-fit: cover; display: block; }
</style>
