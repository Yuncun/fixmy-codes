---
// Home page: the "What has Eric been up to?" generator.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="fixmy.codes" description="Eric Shen, software engineer.">
  <section class="gen">
    <button id="gen-ask" type="button">What has Eric been up to?</button>
    <form id="gen-form">
      <input id="gen-scene" type="text" placeholder="or tell him what to do" autocomplete="off" required />
      <button type="submit">Go</button>
    </form>
    <figure id="gen-out" hidden>
      <img id="gen-img" alt="Eric" />
    </figure>
    <p id="gen-status" class="muted" hidden></p>
    <div id="gen-tray" hidden></div>
  </section>
</BaseLayout>

<script>
  const ask = document.getElementById('gen-ask') as HTMLButtonElement;
  const form = document.getElementById('gen-form') as HTMLFormElement;
  const scene = document.getElementById('gen-scene') as HTMLInputElement;
  const out = document.getElementById('gen-out') as HTMLElement;
  const img = document.getElementById('gen-img') as HTMLImageElement;
  const status = document.getElementById('gen-status') as HTMLElement;
  const tray = document.getElementById('gen-tray') as HTMLElement;

  // Tray of this browser's past generations (localStorage, newest first, no server).
  type Item = { url: string; scene: string };
  const KEY = 'gen-tray';
  const load = (): Item[] => { try { return JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch { return []; } };
  const alt = (item: Item) => (item.scene ? `Eric ${item.scene}` : 'Eric');
  const show = (item: Item) => {
    img.src = item.url;
    img.alt = alt(item);
    out.hidden = false;
  };
  const renderTray = (items: Item[]) => {
    tray.replaceChildren(...items.map((item) => {
      const b = document.createElement('button');
      b.type = 'button';
      const t = document.createElement('img');
      t.src = item.url;
      t.alt = alt(item);
      t.loading = 'lazy';
      b.append(t);
      b.addEventListener('click', () => show(item));
      return b;
    }));
    tray.hidden = items.length === 0;
  };
  renderTray(load());

  // body is {preset: true} for the button, {scene} for typed ideas.
  const generate = async (body: { preset?: true; scene?: string }) => {
    status.hidden = false;
    status.textContent = 'Generating…';
    ask.disabled = true;
    try {
      const r = await fetch('/api/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!r.ok) throw new Error(await r.text());
      const { url } = await r.json();
      const item: Item = { url, scene: body.scene ?? '' };
      show(item);
      status.hidden = true;
      const items = [item, ...load()].slice(0, 24);
      try { localStorage.setItem(KEY, JSON.stringify(items)); } catch {}
      renderTray(items);
    } catch (err) {
      status.textContent = `Could not generate: ${(err as Error).message}`;
    } finally {
      ask.disabled = false;
    }
  };
  ask.addEventListener('click', () => generate({ preset: true }));
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    generate({ scene: scene.value });
  });
</script>

<style>
  #gen-ask { display: block; width: 100%; font-size: 1.5rem; font-weight: 600; padding: 0.75rem 1rem; margin-bottom: 0.75rem; }
  #gen-form { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
  #gen-scene { flex: 1; min-width: 0; }
  #gen-out { margin: 0; }
  #gen-img { max-width: 100%; height: auto; display: block; }
  #gen-tray { display: flex; gap: 0.5rem; overflow-x: auto; margin-top: 1.5rem; }
  #gen-tray :global(button) { flex: 0 0 auto; padding: 0; border: 0; background: none; cursor: pointer; }
  #gen-tray :global(img) { width: 72px; height: 96px; object-fit: cover; display: block; }
</style>
